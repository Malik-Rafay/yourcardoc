# Local environment example for development.
# Copy this to .env and fill in the real values (DO NOT commit .env).

# Supabase
SUPABASE_PROJECT_ID="jbucpdxpvrlrwvhnbvjk"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="jbucpdxpvrlrwvhnbvjk"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Lovable AI Gateway (server-only secret)
# This key is REQUIRED for AI features. If your project is hosted on Lovable Cloud
# the key may be auto-provisioned as a server secret and you do NOT need to add it.
# For local development, create or obtain a Lovable gateway API key and paste it here.
LOVABLE_API_KEY="sk_your_lovable_api_key_here"

# Notes:
# - Never commit your real .env file to version control.
# - To set the key for a single PowerShell session before starting the dev server:
#   $env:LOVABLE_API_KEY = "sk_your_lovable_api_key_here"
#   npm run dev
# - To verify Node sees the key in the same terminal:
#   node -e "console.log(process.env.LOVABLE_API_KEY ? 'present' : 'missing')"
